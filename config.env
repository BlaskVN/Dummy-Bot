# Connection and storage
DATABASE_URL=sqlite:data/bot.db?mode=rwc
DATA_DIRECTORY=data
RUST_LOG=rust_discord_bot=info,serenity=warn,poise=info

# Optional comma-separated bot owners; blank uses Discord application ownership
OWNER_IDS=

# Guild defaults and command limits
DEFAULT_PREFIX=!
DEFAULT_LANGUAGE=en
PREFIX_MAX_CHARS=5
PURGE_MAX_MESSAGES=100
PURGE_CONFIRMATION_SECONDS=3
BAN_MAX_DELETE_DAYS=7
PRESENCE_MAX_DURATION_MINUTES=1440

# Runtime and recovery
CACHE_MAX_MESSAGES=500
GATEWAY_RESUME_DELAY_SECONDS=3
GATEWAY_READY_DELAY_SECONDS=5

# Message log and attachment archive
# Keep true only when Message Content is enabled for the bot in Discord Developer Portal.
MESSAGE_CONTENT_ENABLED=true
MESSAGE_PREVIEW_CHARS=900
MESSAGE_LOG_CHUNK_CHARS=1000
MESSAGE_TIMESTAMP_FORMAT="%d/%m %H:%M"
# Discord defaults to 10 MiB; increase only when the log guild supports it.
ATTACHMENT_MAX_BYTES=10485760
# Bounds bandwidth and command duration for one purge.
PURGE_ATTACHMENT_MAX_TOTAL_BYTES=67108864

# Embed colors (24-bit RGB hex)
EMBED_COLOR_PRIMARY=3498db
EMBED_COLOR_SUCCESS=2ecc71
EMBED_COLOR_WARNING=e67e22
EMBED_COLOR_ERROR=e74c3c
EMBED_COLOR_NEUTRAL=95a5a6
EMBED_COLOR_SERVER_INFO=9b59b6
EMBED_COLOR_PRESENCE=7289da
EMBED_COLOR_ONLINE=43b581
EMBED_COLOR_IDLE=faa61a
EMBED_COLOR_DO_NOT_DISTURB=f04747
EMBED_COLOR_INVISIBLE=747f8d
